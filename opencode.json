{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "openai/gpt-5.3-codex",
  "small_model": "openai/gpt-5.4-mini",
  "formatter": true,
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "env": {
        "VIRTUAL_ENV": ".venv"
      },
      "initialization": {
        "settings": {
          "python": {
            "pythonPath": ".venv/bin/python",
            "analysis": {
              "typeCheckingMode": "basic",
              "useLibraryCodeForTypes": true,
              "autoSearchPaths": true,
              "extraPaths": ["src"]
            }
          }
        }
      }
    }
  },
  "mcp": {
    "docker": {
      "type": "local",
      "command": [
        "docker", "run", "--rm", "-i",
        "-v", "/var/run/docker.sock:/var/run/docker.sock",
        "vonwig/mcp-server-docker:latest"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "pdf": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "--silent",
        "--registry=https://registry.npmjs.org/",
        "@modelcontextprotocol/server-pdf",
        "--stdio"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "talonic_ocr": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@talonic/mcp@latest"
      ],
      "enabled": false,
      "timeout": 30000
    }
  },
  "plugin": [
    "opencode-shell-strategy",
    "opencode-dynamic-context-pruning"
  ],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.3-codex",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "model": "openai/gpt-5.4-mini",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "general": {
      "model": "digitalocean/anthropic-claude-4.6-sonnet"
    },
    "explore": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "review": {
      "model": "digitalocean/anthropic-claude-4.6-sonnet",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "test": {
      "model": "openai/gpt-5.4-mini",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "allow"
        }
      }
    }
  }
}

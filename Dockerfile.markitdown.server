# MarkItDown Server Dockerfile
# HTTP API wrapper for batch PDF/document conversion
#
# Usage:
#   docker build -f Dockerfile.markitdown.server -t markitdown-server:latest .
#   docker-compose -f docker-compose.markitdown.yml --profile server up markitdown-server

FROM python:3.12-slim-bookworm

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmupdf-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir -e ".[pdf,services]"

COPY scripts ./scripts

# Create non-root user
RUN useradd -m -u 1000 markitdown
USER markitdown

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "scripts.markitdown_server:app", \
     "--host", "0.0.0.0", "--port", "8080"]
